{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["apps/worker/src/**/*.js", "scripts/**/*.js", "tool/config.js", "tool/src/**/*.js"],
  "exclude": ["node_modules", "data", ".firecrawl", "apps/worker/public", "apps/worker/seed"]
}
